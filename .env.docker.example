# Ejemplo para desarrollo con: docker compose -f docker-compose.dev.yml up
# Copie a ".env" en la raíz del repo (junto a manage.py) o fusione con su .env local.
# Valores de ejemplo — cámbielos en su máquina.

SECRET_KEY=dev-reemplace-por-cadena-larga-y-aleatoria
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Si fusiona con un .env que trae DATABASE_URL de la nube, evite que pise al servicio db:
DJANGO_IGNORE_DATABASE_URL=1

# Deben coincidir con el servicio "db" del compose (el servicio "web" sobrescribe HOST a "db").
POSTGRES_DB=paredes_bienes_dev
POSTGRES_USER=paredes_dev
POSTGRES_PASSWORD=dev_cambiar_en_env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Opcional: puertos en el host (ver docker-compose.dev.yml)
# DJANGO_PUBLISH_PORT=8000
# POSTGRES_PUBLISH_PORT=5433

# Desactivar S3 en local salvo que pruebe contra MinIO
DJANGO_USE_S3_MEDIA=0

# Correo: vacío = backend silencioso en consola (ver backend/settings.py)
EMAIL_HOST=
