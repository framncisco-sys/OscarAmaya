# =============================================================================
# Copie este archivo como ".env" en la raíz del proyecto y rellene los valores.
# Nunca suba ".env" al repositorio (contiene secretos).
# =============================================================================
#
# -----------------------------------------------------------------------------
# DESARROLLO LOCAL (sin Docker) y DOCKER COMPOSE (docker-compose.dev.yml)
# -----------------------------------------------------------------------------
#
# Mínimo recomendado en su máquina (copiar y pegar, luego ajustar):
#
#   SECRET_KEY=cambie-por-50-caracteres-aleatorios-minimo
#   DEBUG=True
#   DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
#
# Si runserver falla con «failed to resolve host …ondigitalocean.com»: además de DATABASE_URL,
# Windows o herramientas pueden definir PGHOST / DB_HOST hacia la nube. Active:
#   DJANGO_IGNORE_DATABASE_URL=1
# y defina POSTGRES_HOST=localhost (y el resto de POSTGRES_*). Así solo se leen esas claves del .env.
# Sin PORT de PaaS, si POSTGRES_HOST sigue siendo el de DigitalOcean el proyecto lo pasa a localhost:5432;
# entonces debe cambiar POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB: «doadmin» y la contraseña de DO
# no existen en su Postgres local (verá «password authentication failed for user doadmin»).
# Si sigue fallando: en Windows busque «Variables de entorno» y elimine DATABASE_URL / PGHOST /
# POSTGRES_HOST duplicadas a nivel de usuario; o deje DJANGO_IGNORE_DATABASE_URL=1 en .env (el
# proyecto borra esas claves del proceso y vuelve a cargar .env con prioridad).
#
#   POSTGRES_DB=paredes_bienes_dev
#   POSTGRES_USER=paredes_dev
#   POSTGRES_PASSWORD=una_clave_solo_para_su_pc
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5432
#
# Con Docker Compose (servicio "db" + "web"):
#   - Copie también las mismas POSTGRES_* en .env; el compose fuerza POSTGRES_HOST=db
#     dentro del contenedor "web" (no ponga POSTGRES_HOST=localhost en .env si solo usa Docker).
#   - Para usar a la vez Postgres nativo y el de Docker: deje POSTGRES_PORT=5432 en .env
#     para herramientas locales; el contenedor db publica 5433→5432 (variable POSTGRES_PUBLISH_PORT).
#   - Tras el primer `docker compose -f docker-compose.dev.yml up`: ejecute migrate (ver comentario
#     al inicio de docker-compose.dev.yml).
#
# Puertos publicados por compose (puede sobreescribir en .env del host):
#   DJANGO_PUBLISH_PORT=8000    → http://127.0.0.1:8000
#   POSTGRES_PUBLISH_PORT=5433  → psql -h 127.0.0.1 -p 5433 -U paredes_dev paredes_bienes_dev
#
# Hot-reload: con el volumen .:/app y `manage.py runserver`, Django recarga al guardar archivos .py.
#
# Variables que NO debe igualar a producción: POSTGRES_*, SECRET_KEY, credenciales S3, SMTP, tokens WhatsApp.
#
# -----------------------------------------------------------------------------

# --- Django general ---
# SECRET_KEY=...   # Obligatorio en producción (generar una clave larga y aleatoria)
# DEBUG=False
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,tu-app.ondigitalocean.app
# En DigitalOcean App Platform puede omitir hosts si deja activo el respaldo (por defecto):
# Por defecto se permite .ondigitalocean.app (App Platform). Para desactivar:
# DJANGO_DISABLE_ONDIGITALOCEAN_HOST=1
#
# --- Producción / DigitalOcean / HTTPS ---
# Orígenes completos con https:// (obligatorio si usa HTTPS y no es solo localhost)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.ondigitalocean.app,https://tudominio.com
# Redirección HTTPS en Django (suele dejarse False si el proxy ya fuerza HTTPS)
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# Forzar WhiteNoise con DEBUG=True (pruebas)
# DJANGO_USE_WHITENOISE=1
# Cabecera X-Forwarded-Host del proxy (casi siempre True en DO)
# DJANGO_USE_X_FORWARDED_HOST=True
# Diagnóstico de rutas en consola (solo depuración)
# PBR_URLCONF_PROBE=0
# URL pública del sitio (recibos, enlaces en WhatsApp wa.me)
# PUBLIC_BASE_URL=https://tu-app.ondigitalocean.app
# Con DEBUG=False, /media/ no se sirve salvo:
# DJANGO_SERVE_MEDIA_PUBLIC=1
# (PDF accesibles por URL sin login; copie también EMAIL_* y lo anterior en App Platform, no solo en .env local)
#
# --- Media persistente (DigitalOcean Spaces / S3) — recomendado en App Platform ---
# Sin esto, cada redeploy borra /workspace/media/ (PDFs y planos subidos).
# 1) Cree un Space en DO (misma región que la app si puede). 2) Claves en API → Spaces keys.
# 3) En el Web Service defina (ejemplo región nyc3):
#
# DJANGO_USE_S3_MEDIA=1
# AWS_ACCESS_KEY_ID=<spaces_key>
# AWS_SECRET_ACCESS_KEY=<spaces_secret>
# AWS_STORAGE_BUCKET_NAME=nombre-de-su-space
# AWS_S3_REGION_NAME=nyc3
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AWS_DEFAULT_ACL=private
# AWS_QUERYSTRING_AUTH=True
#
# MEDIA_URL se calcula como https://<bucket>.<region>.digitaloceanspaces.com/
# Opcional: dominio CDN o el del Space ya personalizado:
# AWS_S3_CUSTOM_DOMAIN=su-space.nyc3.cdn.digitaloceanspaces.com
# O URL base explícita (p. ej. AWS S3 en vez de Spaces):
# DJANGO_S3_MEDIA_URL=https://mi-bucket.s3.us-east-1.amazonaws.com
#
# ACL public-read solo si acepta PDFs listables por URL directa (menos seguro).
# Con private, Twilio/Meta reciben URL firmada (doc.pdf_file.url).
#
# Auditoría: registrar en BD creación/edición/borrado de modelos de negocio (visible en /app/auditoria/ para administradores).
# AUDIT_SIGNALS_ENABLED=False   # poner False para desactivar y aligerar escrituras

# --- Base de datos PostgreSQL ---
# Antes de desplegar: python manage.py validate_digitalocean --as-app-platform
# (Las mismas variables deben existir en DigitalOcean → Web Service → Environment.)
# App Platform suele inyectar DATABASE_URL al vincular PostgreSQL; si existe, prevalece sobre POSTGRES_*.
# DATABASE_URL=postgresql://user:pass@host:25060/defaultdb?sslmode=require
# Solo desarrollo: Gunicorn con PORT y Postgres en localhost (evita error de configuración en PaaS).
# DJANGO_ALLOW_LOCALHOST_DB=1
POSTGRES_DB=paredes_bienes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Bases administradas en la nube (p. ej. DigitalOcean) suelen exigir SSL:
# POSTGRES_SSLMODE=require

# --- Correo (todo desde variables; sin credenciales fijas en código) ---
# Si no define EMAIL_HOST, el sistema usa un backend de consola silencioso (desarrollo).
#
# Gmail (TLS, puerto 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Outlook / Microsoft 365 (habilitar SMTP AUTH en el administrador):
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Yahoo (SSL implícito, puerto 465):
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
#
# Hosting / correo corporativo (ajustar según su proveedor):
# EMAIL_HOST=mail.suempresa.com.sv
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=paredesinmobi@gmail.com
EMAIL_HOST_PASSWORD=
# Remitente de recibos (From). Recomendación: déjelo vacío para que coincida con EMAIL_HOST_USER
# (muchas veces el hosting exige la misma cuenta que autentica en SMTP).
# Si lo define, use el mismo correo que EMAIL_HOST_USER o uno autorizado por su proveedor.
# DEFAULT_FROM_EMAIL=Paredes Desarrollos Inmobiliarios <paredesinmobi@gmail.com>
# Nombre visible si DEFAULT_FROM_EMAIL está vacío y se usa EMAIL_HOST_USER:
# DEFAULT_FROM_EMAIL_NAME=Paredes Desarrollos Inmobiliarios
#
# Opcional: correo para avisos del sistema a usted (errores 500, etc.). No sustituye SMTP.
# ADMIN_EMAIL=
# ADMIN_NAME=Administrador del sistema
#
# Opcional: remitente técnico para esos avisos (por defecto = EMAIL_HOST_USER).
# SERVER_EMAIL=

# Opcional: forzar backend (SendGrid, SES, Mailgun, etc. documentan el valor exacto)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Desarrollo: volcado completo del correo en consola (MIME)
# EMAIL_FULL_CONSOLE=0

# Formato de aceptación: al guardar con las 3 firmas, enviar PDF al cliente (correo + WhatsApp Meta si aplica)
# FORMATO_ACEPTACION_ENVIAR_AL_GUARDAR=1
# FORMATO_ACEPTACION_NOTIFICAR_CADA_GUARDADO=1
# FORMATO_ACEPTACION_ENVIAR_EMAIL=1
# FORMATO_ACEPTACION_ENVIAR_WHATSAPP_META=1
# Con WHATSAPP_CLOUD_ENABLED=1 y token/Phone Number ID, el formato usa Meta aunque RECIBO_ENVIAR_WHATSAPP_META=0.
# FORMATO_ACEPTACION_EMAIL_ASUNTO=Su formato de aceptación (PDF) — Paredes Bienes Raíces
# FORMATO_ACEPTACION_PROMESA_EMAIL_ASUNTO=Su promesa de venta escaneada — Paredes Bienes Raíces

# Recibos por correo al cliente (1=activo)
RECIBO_ENVIAR_EMAIL=1
# Si el cliente no tiene correo, el recibo va a esta bandeja (oficina):
RECIBO_EMAIL_FALLBACK=paredesinmobi@gmail.com
# Nombre en pie de WhatsApp (wa.me/Twilio/Meta) y cuerpo del correo de recibo:
# RECIBO_NOTIFICACION_EMPRESA_NOMBRE=Paredes Desarrollos Inmobiliarios
# RECIBO_EMAIL_ASUNTO=Constancia de pago registrada — Paredes Desarrollos Inmobiliarios (PDF adjunto)

# Vendedor: avisos por correo (requiere SMTP como los recibos a clientes)
# VENDEDOR_NOTIFICAR_CIERRE_EMAIL=1
# VENDEDOR_NOTIFICAR_RECIBO_COMISION_EMAIL=1
# VENDEDOR_CIERRE_EMAIL_ASUNTO=Etapa Cierre / venta — su contrato en el sistema
# VENDEDOR_RECIBO_COMISION_EMAIL_ASUNTO=Recibo de comisión — PDF adjunto

# URL pública HTTPS (wa.me, Meta, etc.)
# PUBLIC_BASE_URL=https://su-dominio.com

# Prefijo país para enlaces wa.me (El Salvador = 503)
# RECIBO_WHATSAPP_PAIS=503

# WhatsApp Cloud API (Meta) — opcional
# WHATSAPP_CLOUD_ENABLED=0
# RECIBO_ENVIAR_WHATSAPP_META=0
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_MAX_PDF_BYTES=104857600

# Twilio WhatsApp — opcional
# RECIBO_ENVIAR_WHATSAPP_TWILIO=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Texto legal en PDF «promesa de venta» (promitente vendedor)
# PBR_PROMESA_RAZON_SOCIAL_VENDEDOR=PAREDES BIENES RAÍCES
# NIT del emisor en recibos (opcional)
# PBR_EMPRESA_NIT=
# Segundos de gracia tras confirmar contraseña en /app/ (edición y borrado; no aplica a superusuarios)
# PBR_SENSITIVE_REAUTH_TTL=900
#
# Mapa catastral (/app/mapa/catastral/): capas Google opcionales junto a OpenStreetMap y Esri
# GOOGLE_MAPS_API_KEY=
