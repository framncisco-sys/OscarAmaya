# =============================================================================
# Copie este archivo como ".env" en la raíz del proyecto y rellene los valores.
# Nunca suba ".env" al repositorio (contiene secretos).
# =============================================================================

# --- Django general ---
# SECRET_KEY=...   # Obligatorio en producción (generar una clave larga y aleatoria)
# DEBUG=False
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,tu-app.ondigitalocean.app
#
# --- Producción / DigitalOcean / HTTPS ---
# Orígenes completos con https:// (obligatorio si usa HTTPS y no es solo localhost)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.ondigitalocean.app,https://tudominio.com
# Redirección HTTPS en Django (suele dejarse False si el proxy ya fuerza HTTPS)
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# Forzar WhiteNoise con DEBUG=True (pruebas)
# DJANGO_USE_WHITENOISE=1
# Cabecera X-Forwarded-Host del proxy (casi siempre True en DO)
# DJANGO_USE_X_FORWARDED_HOST=True
# Diagnóstico de rutas en consola (solo depuración)
# PBR_URLCONF_PROBE=0
# URL pública del sitio (recibos, enlaces)
# PUBLIC_BASE_URL=https://tu-app.ondigitalocean.app
#
# Auditoría: registrar en BD creación/edición/borrado de modelos de negocio (visible en /app/auditoria/ para administradores).
# AUDIT_SIGNALS_ENABLED=False   # poner False para desactivar y aligerar escrituras

# --- Base de datos PostgreSQL ---
POSTGRES_DB=paredes_bienes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Bases administradas en la nube (p. ej. DigitalOcean) suelen exigir SSL:
# POSTGRES_SSLMODE=require

# --- Correo (todo desde variables; sin credenciales fijas en código) ---
# Si no define EMAIL_HOST, el sistema usa un backend de consola silencioso (desarrollo).
#
# Gmail (TLS, puerto 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Outlook / Microsoft 365 (habilitar SMTP AUTH en el administrador):
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Yahoo (SSL implícito, puerto 465):
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
#
# Hosting / correo corporativo (ajustar según su proveedor):
# EMAIL_HOST=mail.suempresa.com.sv
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente de recibos (From). Recomendación: déjelo vacío para que coincida con EMAIL_HOST_USER
# (muchas veces el hosting exige la misma cuenta que autentica en SMTP).
# Si lo define, use el mismo correo que EMAIL_HOST_USER o uno autorizado por su proveedor.
# DEFAULT_FROM_EMAIL=
# Nombre visible si DEFAULT_FROM_EMAIL está vacío y se usa EMAIL_HOST_USER:
# DEFAULT_FROM_EMAIL_NAME=Paredes Bienes Raíces
#
# Opcional: correo para avisos del sistema a usted (errores 500, etc.). No sustituye SMTP.
# ADMIN_EMAIL=
# ADMIN_NAME=Administrador del sistema
#
# Opcional: remitente técnico para esos avisos (por defecto = EMAIL_HOST_USER).
# SERVER_EMAIL=

# Opcional: forzar backend (SendGrid, SES, Mailgun, etc. documentan el valor exacto)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Desarrollo: volcado completo del correo en consola (MIME)
# EMAIL_FULL_CONSOLE=0

# Recibos por correo al cliente (1=activo)
RECIBO_ENVIAR_EMAIL=1
# RECIBO_EMAIL_ASUNTO=Su recibo de pago — Paredes Bienes Raíces

# URL pública HTTPS (wa.me, Meta, etc.)
# PUBLIC_BASE_URL=https://su-dominio.com

# Prefijo país para enlaces wa.me (El Salvador = 503)
# RECIBO_WHATSAPP_PAIS=503

# WhatsApp Cloud API (Meta) — opcional
# WHATSAPP_CLOUD_ENABLED=0
# RECIBO_ENVIAR_WHATSAPP_META=0
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_MAX_PDF_BYTES=104857600

# Twilio WhatsApp — opcional
# RECIBO_ENVIAR_WHATSAPP_TWILIO=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Texto legal en PDF «promesa de venta» (promitente vendedor)
# PBR_PROMESA_RAZON_SOCIAL_VENDEDOR=PAREDES BIENES RAÍCES
# NIT del emisor en recibos (opcional)
# PBR_EMPRESA_NIT=
# Segundos de gracia tras confirmar contraseña en /app/ (edición y borrado; no aplica a superusuarios)
# PBR_SENSITIVE_REAUTH_TTL=900
